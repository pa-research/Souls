<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Souls.Sim</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Games run in parallel and allocate fast (the bots' lookahead copies the game for every move): with the
         workstation GC eight threads were no faster than one, with the server GC about three times as fast. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- A heap per core from the start: adapting the heap count (DATAS) paused 4,000 games on 8 threads 4 s instead
         of 1 s. -->
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <!-- A run is short: instrumenting code for profile-guided optimization costs more than it gains (about 10%). -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Souls.Server\Souls.Server.csproj" />
  </ItemGroup>

</Project>
