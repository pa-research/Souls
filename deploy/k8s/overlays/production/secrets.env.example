# Managed PostgreSQL, TLS verified against the server certificate.
ConnectionStrings__Souls=Host=db.example.internal;Port=5432;Database=souls;Username=souls;Password=change-me;SSL Mode=VerifyFull
# Bootstrap administrator created by the migration (username: Souls__Admin__Username in the config map).
Souls__Admin__Password=change-me-too
# Data Protection certificate (base64 PFX) that encrypts the login cookie keys in the database; see the README.
Souls__DataProtection__Certificate=change-me
