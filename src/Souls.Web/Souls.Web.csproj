<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Souls.Web</RootNamespace>
    <UserSecretsId>souls-web</UserSecretsId>
    <!-- Dates and numbers are formatted in the page language (ICU; the image is the chiseled-extra one). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The heroes' models go out compressed too (gzip/brotli at publish): a phone in Discord loads them over the air. -->
    <CompressionIncludePatterns>$(CompressionIncludePatterns);**/*.glb</CompressionIncludePatterns>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Souls.Model\Souls.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Souls.Tests" />
  </ItemGroup>

</Project>
