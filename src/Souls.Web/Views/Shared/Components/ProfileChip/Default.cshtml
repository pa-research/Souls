@model ProfileChip?
@if (Model is not null)
{
    <div class="s-profile">
        <span class="s-chip s-chip-coin" title="@L["Soul Coins"]"><s-icon name="coin" /> <span class="s-num" aria-hidden="true">@Model.Money</span><span class="s-sr-only">@L["{0} soul coins", Model.Money]</span></span>
        <s-rank rank="@Model.Rank" rating="@Model.Rating" class="s-profile-rank d-none d-xxl-inline-flex" />
        <a class="s-profile-who s-player-link" asp-controller="Player" asp-action="Profile" asp-route-name="@Model.Name" title="@L["Your profile"]">
            <img class="s-profile-portrait" src="/Content/Images/Player/Portraits/@(Model.Type).jpg" alt="" width="36" height="36" />
            <span class="s-profile-name">@Model.Name<small>@Model.TypeName</small></span>
        </a>
    </div>
}
