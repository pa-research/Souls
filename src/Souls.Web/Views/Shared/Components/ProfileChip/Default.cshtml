@model ProfileChip?
@if (Model is not null)
{
    <div class="s-profile">
        <span class="s-chip s-chip-coin" title="Soul coins"><s-icon name="coin" /> <span class="s-num">@Model.Money</span><span class="s-sr-only"> soul coins</span></span>
        <s-rank rank="@Model.Rank" rating="@Model.Rating" class="s-profile-rank d-none d-xl-inline-flex" />
        <span class="s-profile-who">
            <img class="s-profile-portrait" src="/Content/Images/Player/Portraits/@(Model.Type).png" alt="" width="36" height="36" />
            <span class="s-profile-name">@Model.Name<small>@Model.TypeName</small></span>
        </span>
    </div>
}
