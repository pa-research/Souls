@model PlayerSummary
<dl class="player-wrapper row p-2 mb-0">
    <dt class="col-6">Name</dt><dd class="col-6">@Model.Name</dd>
    <dt class="col-6">Race</dt><dd class="col-6">@Model.Race</dd>
    <dt class="col-6">Soul Coins</dt><dd class="col-6">@Model.Money</dd>
    <dt class="col-6">Rank</dt><dd class="col-6">@Model.Rank</dd>
    <dt class="col-6">Faction</dt><dd class="col-6">@Model.Type</dd>
    <dt class="col-6">Health</dt><dd class="col-6">@Model.Health</dd>
    <dt class="col-6">Bonus Mana</dt><dd class="col-6">@Model.BonusMana</dd>
</dl>
