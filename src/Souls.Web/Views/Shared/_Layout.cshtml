<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Souls Online - a multiplayer card game" />
    <title>@ViewData["Title"] - Souls Online</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/jquery-ui/themes/base/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/Content/CSS/Base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["FullScreen"] is true ? "full-screen" : null)">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-bottom">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Souls Online</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="main-nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Game" asp-action="Index">Play Now!</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Deck" asp-action="Index">Deck</a></li>
                    @if (User.IsAdmin())
                    {
                        <li class="nav-item dropup">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Players">Players</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Games">Games</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="CardEditor" asp-route-id="">Card Editor</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="NewsEditor" asp-route-id="">News Editor</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><span class="navbar-text me-2">@User.Identity.Name</span></li>
                        <li class="nav-item">
                            <form asp-controller="Player" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Player" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Player" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="page-wrapper container-xxl">
        @if (ViewData["FullScreen"] is not true)
        {
            <header class="page-top">
                <a asp-controller="Home" asp-action="Index" class="page-logo" aria-label="Souls Online"></a>
            </header>
        }

        <main class="page-content">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success" role="status">@message</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
