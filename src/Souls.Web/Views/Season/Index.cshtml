@using System.Globalization
@using Souls.Model
@model SeasonViewModel
@{
    var season = Model.Season;
    string Date(DateTimeOffset d) => d.ToString(L["d MMM yyyy"], CultureInfo.CurrentCulture);
}
<div class="s-page-head">
    <div>
        <div class="s-eyebrow">@(Model.IsCurrent ? L["Ranked season · ends {0} UTC", season.EndsAt.ToString(L["d MMM yyyy HH:mm"], CultureInfo.CurrentCulture)] : L["Final standings · {0} to {1}", Date(season.StartsAt), Date(season.EndsAt)])</div>
        <h1 class="s-h1 s-gold-text">@SeasonName(season)</h1>
        <p>@L["When a season ends, every rating moves halfway back to {0} and everyone who played a ranked game in it is paid for the tier they finished in.", Ratings.Initial]</p>
    </div>
    @if (Model.Seasons.Count > 1)
    {
        <nav class="s-seg" aria-label="@L["Seasons"]">
            @foreach (var s in Model.Seasons)
            {
                <a asp-action="Index" asp-route-id="@s.Number" class="text-decoration-none @(s.Number == season.Number ? "active" : null)" aria-current="@(s.Number == season.Number ? "page" : null)">@SeasonName(s)</a>
            }
        </nav>
    }
</div>

<div class="s-season-grid">
<section class="s-panel s-rise s-ladder" aria-labelledby="ladder-title">
    <div class="s-panel-head"><s-icon name="crown" /><h2 id="ladder-title">@L["Ranked ladder"]</h2><span class="s-small s-muted ms-auto">@(Model.Players == 1 ? L["1 player"] : L["{0} players", Model.Players])</span></div>
    @{
        var most = Math.Max(1, Model.Ladder.Max(r => r.Players));
        var myRank = Model.Me is { } me ? Math.Min(me.Rank, Ratings.ChampionRank) : 0;
    }
    @foreach (var tier in Model.Ladder.GroupBy(r => Ratings.TierOf(r.Rank).Name))
    {
        var top = Ratings.TierOf(tier.First().Rank);
        var (coins, legendary) = Seasons.Reward(tier.First().Rank);
        <div class="s-ladder-tier @top.Css">
            <div class="s-ladder-tier-head">
                <s-rank rank="@tier.First().Rank" compact="true" />
                <h3>@T(top.NameText)</h3>
                <span class="s-chip s-chip-coin" title="@L["Season rewards"]"><s-icon name="coin" />@coins@(legendary ? " + " + L["a legendary card"] : "")</span>
            </div>
            <ol class="s-ladder-rungs">
                @foreach (var rung in tier)
                {
                    var low = Ratings.RatingOfRank(rung.Rank);
                    var band = rung.Rank == Ratings.ChampionRank ? $"{low}+" : rung.Rank == 1 ? L["up to {0}", low + Ratings.PointsPerRank - 1].Value : $"{low}–{low + Ratings.PointsPerRank - 1}";
                    var mine = rung.Rank == myRank;
                    <li class="s-ladder-rung @(mine ? "is-me" : null)" style="--share: @(rung.Players * 100 / most)%" aria-current="@(mine ? "true" : null)">
                        <span class="s-ladder-name">@T(Ratings.TierOf(rung.Rank).Text)</span>
                        <span class="s-ladder-band s-num">@band</span>
                        <span class="s-ladder-bar" aria-hidden="true"><span></span></span>
                        <span class="s-ladder-count s-num" aria-label="@(rung.Players == 1 ? L["1 player"] : L["{0} players", rung.Players])">@rung.Players</span>
                        @if (mine)
                        {
                            <span class="s-ladder-you"><s-icon name="user" />@L["You"] <span class="s-num">@Model.Me!.Rating</span>@(Model.Me.Position is { } position ? $" · #{position}" : "")</span>
                        }
                    </li>
                }
            </ol>
        </div>
    }
</section>

<section class="s-panel s-rise" aria-labelledby="standings-title">
    <div class="s-panel-head"><s-icon name="trophy" /><h2 id="standings-title">@(Model.IsCurrent ? L["Top Players"] : L["Final standings"])</h2></div>
    @if (Model.Standings.Count == 0)
    {
        <div class="s-empty">
            <s-icon name="trophy" />
            <p>@(Model.IsCurrent ? L["No ranked games yet this season. Win one and you lead the table."] : L["Nobody played a ranked game this season."])</p>
            @if (Model.IsCurrent)
            {
                <a class="s-btn s-btn-primary s-btn-sm" asp-controller="Game" asp-action="Index"><s-icon name="swords" />@L["Play ranked"]</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="s-table" id="season-standings">
                <thead>
                    <tr>
                        <th>#</th><th>@L["Player"]</th><th>@L["Rank"]</th><th class="text-end">@L["Rating"]</th><th class="text-end">@L["Games"]</th><th class="text-end">@L["Wins"]</th>
                        @if (!Model.IsCurrent)
                        {
                            <th>@L["Reward"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Standings)
                    {
                        <tr>
                            <td class="s-num">@entry.Position</td>
                            <td><a class="s-player-link" asp-controller="Player" asp-action="Profile" asp-route-name="@entry.Name">@entry.Name</a></td>
                            <td><s-rank rank="@entry.Rank" /></td>
                            <td class="text-end s-num">@entry.Rating</td>
                            <td class="text-end s-num">@entry.Games</td>
                            <td class="text-end s-num">@entry.Wins</td>
                            @if (!Model.IsCurrent)
                            {
                                <td class="text-nowrap"><s-icon name="coin" /> @entry.RewardCoins@(entry.RewardCard is null ? "" : $" + {entry.RewardCard}")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
</div>
