@model AdminSeasonViewModel
@{
    var current = Model.Current;
}
<div class="s-admin">
<section class="s-panel">
<div class="s-panel-head"><s-icon name="trophy" /><h2>@current.Name</h2><span class="s-muted s-small">@L["Started {0} UTC, ends {1} UTC", current.StartsAt.ToString("yyyy-MM-dd HH:mm"), current.EndsAt.ToString("yyyy-MM-dd HH:mm")]</span></div>
<p class="s-muted s-small">@L["When the season ends, the game server stores the final standings, pays every player who played a ranked game the reward for their tier, resets every rating halfway to the start and starts the next season (it checks once a minute)."]</p>

<form asp-action="Season" method="post" class="mb-4">
    <div asp-validation-summary="All" class="s-alert s-alert-error empty-hidden"></div>
    <input type="hidden" asp-for="Form.Number" />
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Form.Name" class="form-label">@L["Name"]</label>
            <input asp-for="Form.Name" class="form-control" />
        </div>
        <div class="col-sm-6">
            <label asp-for="Form.EndsAt" class="form-label">@L["Ends at (UTC)"]</label>
            <input asp-for="Form.EndsAt" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
        </div>
    </div>
    <button type="submit" class="s-btn s-btn-primary"><s-icon name="save" />@L["Save"]</button>
</form>

<form asp-action="Season" method="post" data-confirm="@L["End {0} now? Ratings reset and rewards are paid.", current.Name]">
    <input type="hidden" name="Form.Number" value="@current.Number" />
    <input type="hidden" name="Form.Name" value="@current.Name" />
    <input type="hidden" name="endNow" value="true" />
    <button type="submit" class="s-btn s-btn-danger">@L["End the season now"]</button>
</form>
</section>
</div>
