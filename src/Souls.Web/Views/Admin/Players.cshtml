@model AdminPlayersViewModel
<div class="s-admin">
<section class="s-panel">
<div class="s-panel-head"><s-icon name="users" /><h2>Players</h2><span class="s-muted s-small">Online status, kick, ban and reset are live actions on the game server.</span></div>

<div class="table-responsive">
    <table class="table table-sm align-middle" id="admin-players">
        <thead>
            <tr><th>Id</th><th>Name</th><th>Money</th><th title="Cards owned and the sum of their levels">Cards (levels)</th><th>Rank</th><th>Created</th><th>Permission</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var player in Model.Players)
            {
                var cards = Model.Cards.GetValueOrDefault(player.Id);
                <tr data-player-id="@player.Id">
                    <td>@player.Id</td>
                    <td>@player.Name</td>
                    <td>@player.Money</td>
                    <td>@cards.Count (@cards.Levels)</td>
                    <td>@player.Rank</td>
                    <td>@player.Created?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <form asp-action="ChangePermission" method="post" class="d-flex gap-1 permission-form">
                            <input type="hidden" name="userId" value="@player.Id" />
                            <select name="permission" class="form-select form-select-sm w-auto">
                                @foreach (var permission in Model.Permissions)
                                {
                                    <option value="@permission.Id" selected="@(permission.Id == player.PlayerPermissionId)">@permission.Name</option>
                                }
                            </select>
                            <button type="submit" class="s-btn s-btn-ghost s-btn-sm">Save</button>
                        </form>
                    </td>
                    <td class="player-status text-body-secondary fw-bold">Offline</td>
                    <td class="text-nowrap">
                        <button type="button" class="s-btn s-btn-ghost s-btn-sm kick">Kick</button>
                        <input type="date" class="form-control form-control-sm d-inline-block w-auto ban-until" aria-label="Ban until" />
                        <button type="button" class="s-btn s-btn-ghost s-btn-sm ban">Ban</button>
                        <button type="button" class="s-btn s-btn-ghost s-btn-sm reset">Reset</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</section>
</div>

@section scripts {
    <script src="~/js/admin-players.js" asp-append-version="true"></script>
}
