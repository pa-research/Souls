@model CardStatisticsViewModel
@{
    string? Faint(WinRate rate) => rate.Games < CardStatisticsViewModel.FewGames ? "opacity-50" : null;
}
<div class="s-admin">
<section class="s-panel">
<div class="s-panel-head"><s-icon name="gauge" /><h2>@L["Card Statistics"]</h2><span class="s-muted s-small">@L["Win rate of the player who played the card, in decided games between players (draws and practice games are left out), to compare with docs/balance.md. Numbers from fewer than {0} games are faded: too few to trust.", CardStatisticsViewModel.FewGames]</span></div>

<div class="table-responsive">
    <table class="table table-sm align-middle" id="card-statistics">
        <thead>
            <tr>
                <th>@L["Card"]</th><th>@L["Race"]</th><th>@L["Rarity"]</th><th class="text-end">@L["Games"]</th><th class="text-end">@L["Wins"]</th><th class="text-end">@L["Win rate"]</th>
                @foreach (var type in Model.Classes)
                {
                    <th class="text-end">@type.Name</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Cards)
            {
                <tr data-card-id="@row.Card.Id">
                    <td>@row.Card.Name</td>
                    <td>@row.Card.Race?.Name</td>
                    <td>@T(Souls.Model.Rarity.Text(row.Card.Rarity))</td>
                    <td class="text-end s-num @Faint(row.Total)">@row.Total.Games</td>
                    <td class="text-end s-num @Faint(row.Total)">@row.Total.Wins</td>
                    <td class="text-end s-num @Faint(row.Total)">@row.Total.Percent</td>
                    @foreach (var cell in row.ByClass)
                    {
                        <td class="text-end s-num text-nowrap @Faint(cell)" title="@L["{0} of {1} games won", cell.Wins, cell.Games]">@cell.Percent <span class="s-small">(@cell.Games)</span></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
</section>
</div>
