@model HomeViewModel
@{
    var repository = ViewData["GitHubRepository"] as string;
}
<div class="row g-3">
    <div class="col-lg-9">
        <div class="row g-3">
            <div class="col-md-5">
                <div id="news-carousel" class="carousel slide image-slider-plugin" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active"><img src="~/Content/Images/NewsPosts/post1.png" class="d-block w-100" alt="" /></div>
                        <div class="carousel-item"><img src="~/Content/Images/NewsPosts/post2.png" class="d-block w-100" alt="" /></div>
                        <div class="carousel-item"><img src="~/Content/Images/NewsPosts/post3.png" class="d-block w-100" alt="" /></div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <a class="d-block play-now-button" asp-controller="Game" asp-action="Index" aria-label="Play now"></a>
            </div>

            <div class="col-md-3">
                <div class="game-stats-feed">
                    <p class="game-stats-feed-title">Recent Games</p>
                    <table id="game-stats-feed" class="table table-sm mb-0"><tbody></tbody></table>
                </div>
            </div>

            <div class="col-12 news-plugin">
                <div class="news-wrapper"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        @if (Model.Quests is { } quests)
        {
            <div class="quests-plugin mb-3">
                <p class="services-plugin-title">Daily Quests</p>
                <ul class="list-unstyled mb-0">
                    @foreach (var quest in quests)
                    {
                        <li class="quest @(quest.Done ? "done" : "")">
                            <div class="d-flex justify-content-between gap-2">
                                <span>@(quest.Done ? "\u2714 " : "")@quest.Text</span>
                                <span class="text-nowrap">@quest.Reward coins</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@quest.Text" aria-valuenow="@quest.Progress" aria-valuemin="0" aria-valuemax="@quest.Target">
                                <div class="progress-bar @(quest.Done ? "bg-success" : "bg-warning")" style="width: @(quest.Progress * 100 / Math.Max(1, quest.Target))%">@quest.Progress/@quest.Target</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="leaderboard-plugin mb-3">
            <p class="services-plugin-title">Top Players</p>
            <table class="table table-sm mb-0">
                <thead><tr><th>#</th><th>Name</th><th>Rating</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.TopPlayers)
                    {
                        <tr><td>@p.Position</td><td>@p.Name <span class="text-muted small">@p.Type</span></td><td>@p.Rating</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(repository))
        {
            <div class="github-feed mb-3" data-repository="@repository">
                <p class="github-feed-title">Souls Updates</p>
                <table id="github-feed" class="table table-sm">
                    <thead><tr><th>Message</th><th>Committer</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        }

        <div class="services-plugin">
            <p class="services-plugin-title">Server Status</p>
            <table id="services-plugin" class="table table-sm">
                <thead><tr><th>Service</th><th>Status</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
