@using Souls.Model
@model HomeViewModel
@{
    var repository = ViewData["GitHubRepository"] as string;
    var profile = Model.Profile;
}

<section class="s-hero s-rise" aria-labelledby="hero-title">
    <div class="s-hero-copy">
        <div class="s-eyebrow">@(profile is null ? "A card game of the arena" : $"Welcome back, {profile.Name}")</div>
        <h1 id="hero-title" class="s-title s-gold-text">The Arena Awaits</h1>
        <p>Build a deck of souls, step onto the sand in front of a roaring crowd and fight your way up from Bronze to Champion.</p>
        <div class="s-hero-actions">
            @if (profile is null)
            {
                <a class="s-btn s-btn-primary s-btn-xl s-btn-cta" asp-controller="Player" asp-action="Register"><s-icon name="user-plus" />Join the fight</a>
                <a class="s-btn s-btn-ghost s-btn-lg" asp-controller="Player" asp-action="Login"><s-icon name="login" />Login</a>
            }
            else
            {
                <a class="s-btn s-btn-primary s-btn-xl s-btn-cta" asp-controller="Game" asp-action="Index"><s-icon name="swords" />Play</a>
                <a class="s-btn s-btn-ghost s-btn-lg" asp-controller="Deck" asp-action="Index"><s-icon name="deck" />Deck</a>
            }
        </div>
    </div>
</section>

@if (profile is null)
{
    <section class="s-grid s-features" aria-label="Features">
        <div class="s-panel s-feature s-rise"><s-icon name="deck" /><div><h3>Build your deck</h3><p>Twenty cards: souls of four races, spells and cards only your hero can play. Open card packs to grow your collection.</p></div></div>
        <div class="s-panel s-feature s-rise"><s-icon name="crown" /><div><h3>Climb the ranks</h3><p>Ranked seasons take your rating from Bronze III up to Champion and pay out when they end. Daily quests and wins fill your purse.</p></div></div>
        <div class="s-panel s-feature s-rise"><s-icon name="eye" /><div><h3>Watch and replay</h3><p>Take a seat in the stands for any live match, challenge a friend, or replay any finished game in 3D.</p></div></div>
    </section>
}

@* Two columns: your profile and quests, the news and the live feeds; the leaderboard beside them. *@
<div class="s-grid s-home-grid">
    <div class="s-col-8 s-grid s-home-main">
        @if (profile is not null)
        {
            var tier = Ratings.TierOf(profile.Rank);
            var nextRating = profile.Rating < Ratings.Initial ? Ratings.Initial : profile.Rating - (profile.Rating - Ratings.Initial) % Ratings.PointsPerRank + Ratings.PointsPerRank;
            <div class="s-grid s-home-pair">
                <section class="s-panel s-rise" aria-labelledby="profile-title">
                    <div class="s-panel-head"><s-icon name="user" /><h2 id="profile-title">Profile</h2><span class="s-chip s-chip-coin"><s-icon name="coin" /><span class="s-num">@profile.Money</span></span></div>
                    <div class="s-profile-card">
                        <img class="s-portrait-lg" src="/Content/Images/Player/Portraits/@(profile.Type).png" alt="" />
                        <div>
                            <h2>@profile.Name</h2>
                            <div class="s-muted s-small">@profile.TypeName</div>
                            <s-rank rank="@profile.Rank" rating="@profile.Rating" class="mt-2" />
                        </div>
                        <div style="grid-column: 1 / -1">
                            <div class="d-flex justify-content-between s-small s-muted mb-1"><span>@tier</span><span>Next rank at @nextRating</span></div>
                            <div class="s-progress" style="--p: @((int)(Ratings.RankProgress(profile.Rating) * 100))%"><span></span></div>
                        </div>
                        <div class="s-profile-stats">
                            <div class="s-stat"><b>@profile.Games</b><span>Games</span></div>
                            <div class="s-stat"><b>@profile.Wins</b><span>Wins</span></div>
                            <div class="s-stat"><b>@(profile.Games == 0 ? "-" : $"{profile.Wins * 100 / profile.Games}%")</b><span>Win rate</span></div>
                        </div>
                        @if (Model.Season is { } season)
                        {
                            <div class="s-small" style="grid-column: 1 / -1" id="profile-season">
                                <a asp-controller="Season" asp-action="Index">@season.Season.Name</a>:
                                <span class="s-num">@season.Games</span> ranked games, <span class="s-num">@season.Wins</span> wins
                                <span class="s-muted">&middot; ends @season.Season.EndsAt.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <div class="s-muted">Best finish: @(season.BestFinish is { } best ? $"#{best.Position} in {best.Season!.Name} ({Ratings.TierOf(best.Rank)})" : "none yet")</div>
                            </div>
                        }
                    </div>
                </section>

                @if (Model.Quests is { } quests)
                {
                    <section class="s-panel s-rise" aria-labelledby="quests-title">
                        <div class="s-panel-head"><s-icon name="quest" /><h2 id="quests-title">Daily Quests</h2></div>
                        <ul class="s-quests">
                            @foreach (var quest in quests)
                            {
                                var percent = quest.Progress * 100 / Math.Max(1, quest.Target);
                                <li class="s-quest @(quest.Done ? "done" : null)">
                                    <span class="s-quest-icon"><s-icon name="@(quest.Done ? "check" : "quest")" /></span>
                                    <span class="s-quest-text">@quest.Text</span>
                                    <span class="s-chip s-chip-coin s-quest-reward"><s-icon name="coin" />@quest.Reward</span>
                                    <div>
                                        <div class="s-progress @(quest.Done ? "s-progress-done" : null)" style="--p: @percent%" role="progressbar" aria-label="@quest.Text" aria-valuenow="@quest.Progress" aria-valuemin="0" aria-valuemax="@quest.Target"><span></span></div>
                                        <span class="s-quest-count s-num">@quest.Progress / @quest.Target</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }

        <section class="s-panel s-rise" aria-labelledby="news-title">
            <div class="s-panel-head"><s-icon name="news" /><h2 id="news-title">News</h2></div>
            <div id="news-carousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner rounded-3 overflow-hidden">
                    <div class="carousel-item active"><img src="~/Content/Images/NewsPosts/post1.png" class="d-block w-100" alt="Studies show that Souls is a great game" /></div>
                    <div class="carousel-item"><img src="~/Content/Images/NewsPosts/post2.png" class="d-block w-100" alt="Souls winning game of the year (probably)" /></div>
                    <div class="carousel-item"><img src="~/Content/Images/NewsPosts/post3.png" class="d-block w-100" alt="Spirit wolf coming to Souls" /></div>
                </div>
            </div>
            <div class="news-wrapper"></div>
        </section>

        <div class="s-grid s-home-pair">
            <section class="s-panel s-rise" aria-labelledby="games-title">
                <div class="s-panel-head"><s-icon name="swords" /><h2 id="games-title">Recent Games</h2></div>
                <ul id="game-stats-feed" class="s-feed s-scroll"></ul>
            </section>

            <section class="s-panel s-rise" aria-labelledby="status-title">
                <div class="s-panel-head"><s-icon name="server" /><h2 id="status-title">Server Status</h2></div>
                <ul id="services-plugin" class="s-status"></ul>
            </section>
        </div>
    </div>

    <div class="s-col-4 s-grid s-home-side">
        <section class="s-panel s-rise" aria-labelledby="leaders-title">
            <div class="s-panel-head"><s-icon name="trophy" /><h2 id="leaders-title">Top Players</h2><a class="s-small" asp-controller="Season" asp-action="Index">Season leaderboard</a></div>
            <ol class="s-leaders">
                @foreach (var p in Model.TopPlayers)
                {
                    <li class="s-leader">
                        <span class="s-leader-pos">@p.Position</span>
                        <s-rank rank="@p.Rank" rating="@p.Rating" compact="true" />
                        <span class="s-leader-name">@p.Name<small>@p.Type</small></span>
                        <span class="s-num s-muted">@p.Rating</span>
                    </li>
                }
            </ol>
        </section>

        @if (!string.IsNullOrEmpty(repository))
        {
            <section class="s-panel github-feed s-rise" data-repository="@repository" aria-labelledby="updates-title">
                <div class="s-panel-head"><s-icon name="sparkles" /><h2 id="updates-title">Souls Updates</h2></div>
                <ul id="github-feed" class="s-feed s-scroll"></ul>
            </section>
        }
    </div>
</div>

@section scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
