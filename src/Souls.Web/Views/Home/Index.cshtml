@using System.Globalization
@using Souls.Model
@model HomeViewModel
@{
    var repository = ViewData["GitHubRepository"] as string;
    var profile = Model.Profile;
}

<section class="s-hero s-rise" aria-labelledby="hero-title">
    <div class="s-hero-copy">
        <div class="s-eyebrow">@(profile is null ? L["A card game of the arena"] : L["Welcome back, {0}", profile.Name])</div>
        <h1 id="hero-title" class="s-title s-gold-text">@L["The Arena Awaits"]</h1>
        <p>@L["Build a deck of souls, step onto the sand in front of a roaring crowd and fight your way up from Bronze to Champion."]</p>
        <div class="s-hero-actions">
            @if (profile is null)
            {
                <a class="s-btn s-btn-primary s-btn-xl s-btn-cta" asp-controller="Player" asp-action="Register"><s-icon name="user-plus" />@L["Join the fight"]</a>
                <a class="s-btn s-btn-ghost s-btn-lg" asp-controller="Player" asp-action="Login"><s-icon name="login" />@L["Login"]</a>
            }
            else
            {
                <a class="s-btn s-btn-primary s-btn-xl s-btn-cta" asp-controller="Game" asp-action="Index"><s-icon name="swords" />@L["Play"]</a>
                <a class="s-btn s-btn-ghost s-btn-lg" asp-controller="Deck" asp-action="Index"><s-icon name="deck" />@L["Deck"]</a>
            }
        </div>
    </div>
</section>

@if (profile is null)
{
    <section class="s-grid s-features" aria-label="@L["Features"]">
        <div class="s-panel s-feature s-rise"><s-icon name="deck" /><div><h3>@L["Build your deck"]</h3><p>@L["Twenty cards: souls of four races, spells and cards only your hero can play. Open card packs to grow your collection."]</p></div></div>
        <div class="s-panel s-feature s-rise"><s-icon name="crown" /><div><h3>@L["Climb the ranks"]</h3><p>@L["Ranked seasons take your rating from Bronze III up to Champion and pay out when they end. Daily quests and wins fill your purse."]</p></div></div>
        <div class="s-panel s-feature s-rise"><s-icon name="eye" /><div><h3>@L["Watch and replay"]</h3><p>@L["Take a seat in the stands for any live match, challenge a friend, or replay any finished game in 3D."]</p></div></div>
    </section>
}

@* Two columns: your profile and quests, the news and the live feeds; the leaderboard beside them. *@
<div class="s-grid s-home-grid">
    <div class="s-col-8 s-grid s-home-main">
        @if (profile is not null)
        {
            var tier = Ratings.TierOf(profile.Rank);
            var nextRating = profile.Rating < Ratings.Initial ? Ratings.Initial : profile.Rating - (profile.Rating - Ratings.Initial) % Ratings.PointsPerRank + Ratings.PointsPerRank;
            <div class="s-grid s-home-pair">
                <section class="s-panel s-rise" aria-labelledby="profile-title">
                    <div class="s-panel-head"><s-icon name="user" /><h2 id="profile-title">@L["Profile"]</h2><span class="s-chip s-chip-coin"><s-icon name="coin" /><span class="s-num">@profile.Money</span></span></div>
                    <div class="s-profile-card">
                        <img class="s-portrait-lg" src="/Content/Images/Player/Portraits/@(profile.Type).jpg" alt="" />
                        <div>
                            <h2>@profile.Name</h2>
                            <div class="s-muted s-small">@profile.TypeName</div>
                            <s-rank rank="@profile.Rank" rating="@profile.Rating" class="mt-2" />
                        </div>
                        <div style="grid-column: 1 / -1">
                            <div class="d-flex justify-content-between s-small s-muted mb-1"><span>@T(tier.Text)</span><span>@L["Next rank at {0}", nextRating]</span></div>
                            <div class="s-progress" style="--p: @((int)(Ratings.RankProgress(profile.Rating) * 100))%"><span></span></div>
                        </div>
                        <div class="s-profile-stats">
                            <div class="s-stat"><b>@profile.Games</b><span>@L["Games"]</span></div>
                            <div class="s-stat"><b>@profile.Wins</b><span>@L["Wins"]</span></div>
                            <div class="s-stat"><b>@(profile.Games == 0 ? "-" : $"{profile.Wins * 100 / profile.Games}%")</b><span>@L["Win rate"]</span></div>
                        </div>
                        @if (Model.Season is { } season)
                        {
                            <div class="s-small" style="grid-column: 1 / -1" id="profile-season">
                                <a asp-controller="Season" asp-action="Index">@SeasonName(season.Season)</a>:
                                @L["{0} ranked games, {1} wins", season.Games, season.Wins]
                                <span class="s-muted">&middot; @L["ends {0}", season.Season.EndsAt.ToString(L["d MMM yyyy"], CultureInfo.CurrentCulture)]</span>
                                <div class="s-muted">@(season.BestFinish is { } best ? L["Best finish: #{0} in {1} ({2})", best.Position, SeasonName(best.Season!), T(Ratings.TierOf(best.Rank).Text)] : L["Best finish: none yet"])</div>
                            </div>
                        }
                        <div class="d-flex align-items-center justify-content-between gap-2" style="grid-column: 1 / -1">
                            <span class="s-small s-muted">@L["Language"]</span>
                            <partial name="_LanguagePicker" />
                        </div>
                    </div>
                </section>

                @if (Model.Quests is { } quests)
                {
                    <section class="s-panel s-rise" aria-labelledby="quests-title">
                        <div class="s-panel-head"><s-icon name="quest" /><h2 id="quests-title">@L["Daily Quests"]</h2></div>
                        <ul class="s-quests">
                            @foreach (var quest in quests)
                            {
                                var percent = quest.Progress * 100 / Math.Max(1, quest.Target);
                                <li class="s-quest @(quest.Done ? "done" : null)">
                                    <span class="s-quest-icon"><s-icon name="@(quest.Done ? "check" : "quest")" /></span>
                                    <span class="s-quest-text">@quest.Text</span>
                                    <span class="s-chip s-chip-coin s-quest-reward"><s-icon name="coin" />@quest.Reward</span>
                                    <div>
                                        <div class="s-progress @(quest.Done ? "s-progress-done" : null)" style="--p: @percent%" role="progressbar" aria-label="@quest.Text" aria-valuenow="@quest.Progress" aria-valuemin="0" aria-valuemax="@quest.Target"><span></span></div>
                                        <span class="s-quest-count s-num">@quest.Progress / @quest.Target</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }

        @if (Model.Ladder.Count > 0)
        {
            var tiers = Model.Ladder.GroupBy(r => Ratings.TierOf(r.Rank).Name).Reverse().Select(t => (Rank: t.Last().Rank, Players: t.Sum(r => r.Players))).ToList();
            var most = Math.Max(1, tiers.Max(t => t.Players));
            var myTier = profile is null ? null : Ratings.TierOf(Math.Min(profile.Rank, Ratings.ChampionRank)).Name;
            <section class="s-panel s-rise" aria-labelledby="ladder-title">
                <div class="s-panel-head"><s-icon name="crown" /><h2 id="ladder-title">@L["Ranked ladder"]</h2><a class="s-small" asp-controller="Season" asp-action="Index">@L["Season leaderboard"]</a></div>
                <ol class="s-ladder-strip">
                    @foreach (var (rank, players) in tiers)
                    {
                        var tier = Ratings.TierOf(rank);
                        var mine = tier.Name == myTier;
                        <li class="@tier.Css @(mine ? "is-me" : null)" style="--share: @(players * 100 / most)%" aria-current="@(mine ? "true" : null)">
                            <span class="s-ladder-column" aria-hidden="true"><span></span></span>
                            <s-rank rank="@rank" compact="true" />
                            <span class="s-ladder-strip-name">@T(tier.NameText)</span>
                            <span class="s-ladder-strip-count s-num">@(players == 1 ? L["1 player"] : L["{0} players", players])</span>
                            @if (mine)
                            {
                                <span class="s-ladder-you">@L["You"]</span>
                            }
                        </li>
                    }
                </ol>
            </section>
        }

        @* Posts from the news editor; the panel shows once there is one (home.js). *@
        <section class="s-panel s-rise" aria-labelledby="news-title" id="news-panel" hidden>
            <div class="s-panel-head"><s-icon name="news" /><h2 id="news-title">@L["News"]</h2></div>
            <div class="news-wrapper"></div>
        </section>

        <section class="s-panel s-rise" aria-labelledby="games-title">
            <div class="s-panel-head"><s-icon name="swords" /><h2 id="games-title">@L["Recent Games"]</h2></div>
            <ul id="game-stats-feed" class="s-feed s-scroll" data-empty="@L["No games yet. Be the first!"]" data-vs="@L["{0} vs {1}"]" data-practice="@L["Practice"]"></ul>
        </section>
    </div>

    <div class="s-col-4 s-grid s-home-side">
        <section class="s-panel s-rise" aria-labelledby="leaders-title">
            <div class="s-panel-head"><s-icon name="trophy" /><h2 id="leaders-title">@L["Top Players"]</h2><a class="s-small" asp-controller="Season" asp-action="Index">@L["Season leaderboard"]</a></div>
            <ol class="s-leaders">
                @foreach (var p in Model.TopPlayers)
                {
                    <li class="s-leader">
                        <span class="s-leader-pos">@p.Position</span>
                        <s-rank rank="@p.Rank" rating="@p.Rating" compact="true" />
                        <span class="s-leader-name"><a class="s-player-link" asp-controller="Player" asp-action="Profile" asp-route-name="@p.Name">@p.Name</a><small>@p.Type</small></span>
                        <span class="s-num s-muted">@p.Rating</span>
                    </li>
                }
            </ol>
        </section>

        @if (!string.IsNullOrEmpty(repository))
        {
            <section class="s-panel github-feed s-rise" data-repository="@repository" aria-labelledby="updates-title">
                <div class="s-panel-head"><s-icon name="sparkles" /><h2 id="updates-title">@L["Souls Updates"]</h2></div>
                <ul id="github-feed" class="s-feed s-scroll"></ul>
            </section>
        }
    </div>
</div>

<ul id="services-plugin" class="s-status-strip" aria-label="@L["Server Status"]" data-game-server="@L["Game Server"]" data-database="@L["Database"]" data-online="@L["Online"]" data-offline="@L["Offline"]"></ul>

@section scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
