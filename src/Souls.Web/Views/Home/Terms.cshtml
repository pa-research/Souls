@{
    ViewData["Title"] = L["Terms of Service"].Value;
}
<article class="s-panel s-rise s-legal">
    <h1 class="s-h1 s-gold-text">@L["Terms of Service"]</h1>
    <p>@L["Souls Online is a free card game run as a hobby. By playing it, on this site or in Discord, you accept these terms."]</p>
    <h2>@L["Play fair"]</h2>
    <p>@L["Do not cheat, automate play, exploit bugs or attack the service, and be decent to other players in chat and emotes. Accounts that break this can be banned."]</p>
    <h2>@L["Your account"]</h2>
    <p>@L["An account belongs to the person who made it, on the site or by opening Souls in Discord. Cards, coins and ranks have no money value and cannot be sold."]</p>
    <h2>@L["Discord"]</h2>
    <p>@L["The Souls Activity, the /souls command and Linked Roles run inside Discord, so Discord's own terms apply to them as well."]</p>
    <h2>@L["No warranty"]</h2>
    <p>@L["Souls is provided as it is. It can change, be down or end at any time, and game data can be reset."]</p>
    <h2>@L["Questions"]</h2>
    <p>@L["Questions about these terms: open an issue in the Souls repository on GitHub."]</p>
    <p><a href="https://github.com/pa-research/Souls/issues">github.com/pa-research/Souls</a></p>
</article>
