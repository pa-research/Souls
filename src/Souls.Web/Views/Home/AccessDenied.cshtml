@{
    ViewData["Title"] = L["Access denied"].Value;
}
<section class="s-panel s-error s-rise">
    <div class="s-title s-gold-text">403</div>
    <h1 class="s-h2">@L["Access denied"]</h1>
    <p class="s-muted">@L["You do not have permission to view this page."]</p>
    <a asp-controller="Home" asp-action="Index" class="s-btn s-btn-gold mt-2"><s-icon name="home" />@L["Back to the home page"]</a>
</section>
