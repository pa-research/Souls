@model LoginViewModel
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4 login-form">
        <form asp-controller="Player" asp-action="Login" method="post">
            <fieldset>
                <legend>Authentication</legend>
                <div asp-validation-summary="All" class="text-danger small"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Username</label>
                    <input asp-for="Name" class="form-control" placeholder="Username" autocomplete="username" autofocus />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="submit" class="btn btn-primary">Sign in</button>
                    <span>No account? <a asp-controller="Player" asp-action="Register">Register</a></span>
                </div>
            </fieldset>
        </form>
    </div>
</div>
