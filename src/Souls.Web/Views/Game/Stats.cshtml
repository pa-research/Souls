@using Souls.Model
@model GameStatsViewModel
@{
    static (string Icon, string Css) Kind(StatsLine entry) => entry.Key switch
    {
        null => KindOfEnglish(entry.Text),
        "log.win" or "log.draw" => ("trophy", "s-tl-end"),
        "log.dies" or "log.heroFallen" => ("skull", "s-tl-death"),
        "log.attack" or "log.burn" or "log.deathCurse" => ("sword", "s-tl-attack"),
        "log.heal" or "log.drain" or "log.lifesteal" or "log.blessing" or "log.regenerate" or "log.sacrifice" => ("heart-pulse", "s-tl-heal"),
        "log.turn" or "log.timeout" => ("hourglass", "s-tl-turn"),
        "log.cast" or "log.castOn" => ("sparkles", "s-tl-play"),
        "log.rally" or "log.rally2" or "log.grow" or "log.empower" => ("arrow-up", "s-tl-heal"),
        "log.fatigue" => ("flame", "s-tl-attack"),
        "log.plays" or "log.summon" => ("deck", "s-tl-play"),
        "log.heroPower" or "log.paralyze" or "log.harden" => ("wand", "s-tl-play"),
        "log.haunt" => ("ghost", "s-tl-death"),
        _ => ("flag", ""),
    };

    // Games stored before the log had keys: by the English text.
    static (string Icon, string Css) KindOfEnglish(string line)
    {
        if (line.Contains(" wins against ", StringComparison.Ordinal) || line.Contains(" play a draw", StringComparison.Ordinal)) return ("trophy", "s-tl-end");
        if (line.Contains(" dies", StringComparison.Ordinal) || line.Contains(" has fallen", StringComparison.Ordinal)) return ("skull", "s-tl-death");
        if (line.Contains(" attacks ", StringComparison.Ordinal) || line.Contains(" burns ", StringComparison.Ordinal) || line.Contains("curse", StringComparison.Ordinal)) return ("sword", "s-tl-attack");
        if (line.Contains(" heal", StringComparison.Ordinal) || line.Contains(" drains ", StringComparison.Ordinal) || line.Contains(" blesses ", StringComparison.Ordinal)) return ("heart-pulse", "s-tl-heal");
        if (line.Contains(" gives the turn ", StringComparison.Ordinal) || line.Contains("ran out of time", StringComparison.Ordinal)) return ("hourglass", "s-tl-turn");
        if (line.Contains(" casts ", StringComparison.Ordinal)) return ("sparkles", "s-tl-play");
        if (line.Contains(" rallies ", StringComparison.Ordinal) || line.Contains(" grows stronger", StringComparison.Ordinal) || line.Contains(" empowers ", StringComparison.Ordinal)) return ("arrow-up", "s-tl-heal");
        if (line.Contains(" fatigue damage", StringComparison.Ordinal)) return ("flame", "s-tl-attack");
        if (line.Contains(" plays ", StringComparison.Ordinal) || line.Contains(" summons ", StringComparison.Ordinal)) return ("deck", "s-tl-play");
        if (line.Contains(" uses ", StringComparison.Ordinal) || line.Contains(" paralyzes ", StringComparison.Ordinal) || line.Contains(" hardens ", StringComparison.Ordinal)) return ("wand", "s-tl-play");
        if (line.Contains("haunt", StringComparison.OrdinalIgnoreCase)) return ("ghost", "s-tl-death");
        return ("flag", "");
    }
}
<div class="s-page-head">
    <div>
        @* Friendly games are stored as practice games between two people. *@
        <div class="s-eyebrow">@(!Model.IsPractice ? Model.Players.All(p => p.IsAi) ? L["AI ladder game"] : L["Ranked game"] : Model.Players.Any(p => p.IsSystem) ? L["Practice game"] : L["Friendly game"])@(Model.Turns > 0 ? " · " + L["{0} turns", Model.Turns] : "")</div>
        <h1 class="s-h1 s-gold-text">@L["Game Summary for #{0}", Model.GameId]</h1>
    </div>
    @if (Model.HasReplay)
    {
        <a class="s-btn s-btn-primary s-btn-lg" asp-controller="Game" asp-action="Replay" asp-route-id="@Model.GameId"><s-icon name="play" />@L["Watch the replay in 3D"]</a>
    }
</div>

<section class="s-panel s-rise mb-4" aria-label="@L["Result"]">
    <div class="s-versus">
        @for (var i = 0; i < Model.Players.Count; i++)
        {
            var player = Model.Players[i];
            var won = !Model.IsDraw && Model.Winner?.Id == player.Id;
            var state = Model.IsDraw ? "draw" : won ? "won" : "lost";
            if (i == 1)
            {
                <div class="s-vs-mark" aria-hidden="true">VS</div>
            }
            <div class="s-fighter @state">
                <div class="s-fighter-portrait" style="background-image: url('/Content/Images/Player/Portraits/@(player.PlayerTypeId).jpg');"></div>
                <span class="s-fighter-result">@(Model.IsDraw ? L["Draw"] : won ? L["Victorious"] : L["Defeated"])</span>
                <h2>@(Model.IsDraw ? L["{0} the Undefeated", PlayerName(player.Name)] : won ? L["{0} the Victorious", PlayerName(player.Name)] : L["{0} the Defeated", PlayerName(player.Name)])</h2>
                @if (player.IsAi)
                {
                    <partial name="_AiTag" />
                }
                @if (!player.IsSystem)
                {
                    <a class="s-small" asp-controller="Player" asp-action="Profile" asp-route-name="@player.Name"><s-icon name="user" /> @L["Profile"]</a>
                }
                <div class="s-fighter-meta">
                    @if (!player.IsSystem)
                    {
                        <s-rank rank="@player.Rank" rating="@player.Rating" />
                    }
                    @if (!Model.IsPractice && Model.RatingChanges[i] != 0)
                    {
                        var change = Model.RatingChanges[i];
                        <span class="s-chip @(change > 0 ? "s-chip-up" : "s-chip-down")">@L["Rating: {0} ({1})", player.Rating, (change > 0 ? "+" : "") + change]</span>
                    }
                </div>
                <div class="s-fighter-meta mt-2">
                    <span class="s-chip">@player.PlayerType?.Name</span>
                    <span class="s-chip" title="@L["Attack"]"><s-icon name="sword" />@player.PlayerType?.Attack</span>
                    <span class="s-chip" title="@L["Health"]"><s-icon name="heart" />@player.PlayerType?.Health</span>
                </div>
                @if (!player.IsSystem && User.GetPlayerId() is { } me && me != player.Id)
                {
                    <a class="s-btn s-btn-ghost s-btn-sm mt-2" asp-controller="Game" asp-action="Index" asp-route-challenge="@player.Name"><s-icon name="swords" />@L["Challenge"]</a>
                }
            </div>
        }
    </div>
</section>

<section class="s-panel s-rise" aria-labelledby="history-title">
    <div class="s-panel-head"><s-icon name="list" /><h2 id="history-title">@L["Game History"]</h2><span class="s-chip">@L["{0} events", Model.Log.Count]</span></div>
    <ol class="s-timeline s-scroll">
        @foreach (var line in Model.Log)
        {
            var (icon, css) = Kind(line);
            <li class="@css"><span class="s-tl-icon"><s-icon name="@icon" /></span><span>@line.Text</span></li>
        }
    </ol>
</section>
