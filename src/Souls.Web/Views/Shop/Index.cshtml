@model ShopViewModel
<div class="row align-items-center mb-3">
    <div class="col-md-6 hansels-shop-title">
        <h2>Hansel's Card Shop</h2>
        <p>Hansel was once the champion of souls.<br />Now he sells cards to feed himself and his wife.</p>
    </div>
    <div class="col-md-6"><div class="hansel"></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-3">
        <partial name="_PlayerInfo" model="Model.Player" />
        <p class="small text-muted mt-2">Win games and finish daily quests to earn soul coins. Buying a card you own levels it up: +1 attack and +1 health per level (up to level 3).</p>
        <a class="btn btn-sm btn-dark" asp-controller="Deck" asp-action="Index">Build your deck</a>
    </div>
    <div class="col-lg-9">
        <div class="row g-3">
            @foreach (var card in Model.Cards)
            {
                <div class="col-6 col-md-4 col-xl-3 shop-card">
                    <partial name="_CardTile" model="card" />
                    @if (card.Owned)
                    {
                        <div class="text-muted small">Owned &middot; level @card.Level</div>
                        @if (card.UpgradeCost is { } cost)
                        {
                            <form asp-controller="Shop" asp-action="Upgrade" method="post" class="buy-form" data-card-name="@card.Name" data-price="@cost" data-upgrade="true">
                                <input type="hidden" name="cardId" value="@card.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Upgrade to level @(card.Level + 1) for @cost soul coins</button>
                            </form>
                        }
                    }
                    else
                    {
                        <form asp-controller="Shop" asp-action="Buy" method="post" class="buy-form" data-card-name="@card.Name" data-price="@card.VendorPrice">
                            <input type="hidden" name="cardId" value="@card.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Buy for @card.VendorPrice soul coins</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div id="buy-confirm" title="Purchase" class="d-none">
    <p id="buy-confirm-message"></p>
</div>

@section scripts {
    <script src="~/js/shop.js" asp-append-version="true"></script>
}
