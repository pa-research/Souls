@using Souls.Model
@model IReadOnlyList<PackCard>
<section class="s-page-head">
    <div>
        <div class="s-eyebrow">@L["Hansel's Card Shop"]</div>
        <h1 class="s-h1 s-gold-text">@L["Your Card Pack"]</h1>
        <p>@L["Tap a card to turn it over. A card you already owned levels up; at level {0} it pays back half its price.", GameRules.MaxCardLevel]</p>
    </div>
    <button type="button" class="s-btn s-btn-primary s-btn-lg" id="pack-reveal-all"><s-icon name="sparkles" />@L["Reveal all"]</button>
</section>

<ol class="s-pack" aria-label="@L["The cards in your pack"]">
    @for (var i = 0; i < Model.Count; i++)
    {
        var item = Model[i];
        var result = item.Coins > 0 ? (item.Coins == 1 ? L["+{0} soul coin", item.Coins] : L["+{0} soul coins", item.Coins])
            : item.Card.Level == 1 ? L["New card"] : L["Level {0}", item.Card.Level];
        <li class="s-pack-slot s-rise rarity-@item.Card.RarityCss" style="--i: @i">
            <button type="button" class="s-pack-card" aria-label="@L["Card {0}, face down. Turn it over.", i + 1]" data-label="@item.Card.Name, @item.Card.RarityName: @result">
                <span class="s-pack-inner">
                    <span class="s-pack-face s-pack-back"></span>
                    <span class="s-pack-face s-pack-front"><partial name="_CardTile" model="item.Card" /></span>
                </span>
            </button>
            <p class="s-pack-result">
                <span class="s-card-name">@item.Card.Name</span>
                <span class="s-rarity">@item.Card.RarityName</span>
                <span class="s-chip @(item.Coins > 0 ? "s-chip-coin" : "s-chip-up")">@result</span>
            </p>
        </li>
    }
</ol>
<p class="s-sr-only" id="pack-status" aria-live="polite"></p>

<div class="s-pack-actions">
    <a class="s-btn s-btn-gold" asp-action="Index"><s-icon name="shop" />@L["Back to the shop"]</a>
    <a class="s-btn s-btn-ghost" asp-controller="Deck" asp-action="Index"><s-icon name="deck" />@L["Build your deck"]</a>
</div>

@section scripts {
    <script src="~/js/shop.js" asp-append-version="true"></script>
}
